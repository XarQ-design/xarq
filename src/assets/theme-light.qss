/* The light look is the application's stylesheet turned over (theme.cpp); this file is added after it, in the light
   look only, for what the turning over doesn't get right. Its colours are written as they are drawn. As in
   Subtitld's graphics/stylesheet_light.qss. */

/* Progress reads in the palette's #566f84: a pale fill, as on the dark look, would hardly show on a light ground. */
QProgressBar::chunk { background: #566f84; }

/* Scroll bars: a solid handle (the dark look's handle artwork turned over reads as an odd bevel). */
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { border-image: none; border: 0; border-radius: 3px; background: #b3c1cd; }
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { border-image: none; background: #8fa1b1; }

/* The primary buttons: the dark look's own primary gradient (#627f97 → #4a5f71), with light text. */
QPushButton:default, QPushButton[class="primary"] { background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #627f97, stop:1 #4a5f71); color: #ffffff; }
QPushButton:default:hover, QPushButton[class="primary"]:hover { background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #7892a8, stop:1 #59738a); }
QPushButton:default:pressed, QPushButton[class="primary"]:pressed { background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #4a5f71, stop:1 #566f84); }
QPushButton:default:disabled, QPushButton[class="primary"]:disabled { background: #e3e9ee; color: rgba(62, 83, 99, 150); }

/* A dialog's main action sits on its tab (blue here, assets/chrome/light/dialog-bottom-right.svg), so it is
   labelled white. */
QWidget#dialogBottom QPushButton[footer="tab"], QWidget#dialogBottom QPushButton[footer="tab"]:hover { color: #ffffff; }
QWidget#dialogBottom QPushButton[footer="tab"]:disabled { color: rgba(255, 255, 255, 128); }

/* The rail's chosen tool: its bar and label in the palette's #566f84 (turned over, the sky bar would vanish). */
#toolrail QToolButton:checked { border-left: 3px solid #566f84; color: #304251; }
